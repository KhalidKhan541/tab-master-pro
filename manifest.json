{
  "manifest_version": 3,
  "name": "Tab Master Pro",
  "version": "1.0.0",
  "description": "Advanced tab manager with sessions, grouping, and powerful organization tools.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "bookmarks",
    "sessions",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Master Pro"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}